# -----------------------------------------------------------
# متغيرات البيئة (Secrets) — لا تكتب القيم الحقيقية هنا أبداً.
# هاد الملف للتوثيق فقط. القيم الحقيقية تُضاف من إعدادات
# الاستضافة (Cloudflare / Vercel...) كـ Secrets آمنة.
# -----------------------------------------------------------

# توكن بوت Telegram (سري تماماً، ما يتحطش فالكود ولا فالواجهة)
TELEGRAM_BOT_TOKEN=

# معرف المحادثة اللي غادي توصل ليها الطلبات (له قيمة افتراضية فالكود)
TELEGRAM_CHAT_ID=6781508116

# دومين المتجر المسموح له بإرسال الطلبات إلى الـ Backend (CORS)
ALLOWED_ORIGIN=https://your-store-domain.com
